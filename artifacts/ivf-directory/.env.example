# Copy to .env.local for Vite development. Firebase Hosting can supply these
# values automatically from /__/firebase/init.json after web app registration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ivf-directory-india.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ivf-directory-india
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
