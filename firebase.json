{
  "functions": [{
    "source": ".firebase-build",
    "codebase": "ivf-directory",
    "runtime": "nodejs22",
    "predeploy": ["pnpm --filter @workspace/api-server build:firebase"],
    "ignore": ["node_modules", "*.log"]
  }],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "artifacts/ivf-directory/dist/public",
    "predeploy": ["pnpm --filter @workspace/ivf-directory build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [{ "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5002 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
